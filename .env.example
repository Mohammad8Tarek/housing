# Sunrise Housing - Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=staff-housing
DB_PORT=5432
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/staff-housing

# Redis (optional — used for job queues and rate limiting)
REDIS_URL=redis://localhost:6379

# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-secret

# Frontend ports
FRONTEND_PORT=9000
PORTAL_PORT=10000

# CORS
ALLOWED_ORIGINS=http://localhost:9000,http://localhost:10000

# Session
SESSION_TIMEOUT_MS=1800000
SESSION_COOKIE_NAME=sunrise.sid
# memory (single instance, sessions lost on restart) or postgresql (table public.user_sessions, survives restarts/scales out)
SESSION_STORE=postgresql
SESSION_TABLE=user_sessions

# Logging
LOG_LEVEL=info

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:sunrise-housing@example.com

# Firebase Cloud Messaging (native Android/iOS push via the Capacitor app).
# Paste the service-account JSON (single line) OR point to the file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
