# Root ignore file for generated artifacts and sensitive local files

# Dependency folders
**/node_modules/

# Build output
dist/
build/
.artifacts/
*.tsbuildinfo

# Backups directory
backups/

# Sensitive runtime files (session data, PIDs, cookies)
*.pid
cookies.txt

# Scratch/test scripts (should live in dedicated test folders)
scratch_*.ts
test-*.ts

# Logs
*.log
*.log.new
*.err.txt
*.out.txt

# Environment files
.env
.env.local
.env.*.local

# Generated bundles, database dumps, and one-off repair artifacts
/source-bundle.md
/dump.sql
/full_dump.sql
/corrupted_strings.json
/corrupted_english_strings.txt
*.bak
*.rar

# Local one-off debug scripts
test-*.js
test-*.mjs
check-*.js

# IDE / OS files
.vscode/
.DS_Store
Thumbs.db
postgres_bin/
