FROM node:22-alpine AS builder
RUN npm install -g pnpm
WORKDIR /app
COPY pnpm-workspace.yaml package.json tsconfig.json tsconfig.base.json ./
COPY lib/db/package.json ./lib/db/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/housing/package.json ./artifacts/housing/
COPY artifacts/employee-portal/package.json ./artifacts/employee-portal/
COPY interfaces/hr-sync/package.json ./interfaces/hr-sync/
RUN pnpm install
COPY lib/ ./lib/
COPY artifacts/housing/ ./artifacts/housing/
ENV PORT=9000
ENV API_PORT=4000
ENV NODE_ENV=production
RUN cd artifacts/housing && npx vite build --config vite.config.ts

FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/housing/dist/public /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 9000
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:9000 || exit 1
CMD ["nginx", "-g", "daemon off;"]
