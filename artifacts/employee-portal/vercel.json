{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://housing-api-server-fjozsbva7-mohammad8tareks-projects.vercel.app/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "wss://housing-api-server-fjozsbva7-mohammad8tareks-projects.vercel.app/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
