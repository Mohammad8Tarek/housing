{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sunrise-api-production-2410.up.railway.app/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "wss://sunrise-api-production-2410.up.railway.app/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
